# domain name
DOMAIN_NAME=your-domain.com

# services
SERV_DIR=services

# ports
FRONTEND_PORT=5173
BACKEND_PORT=3000
DATABASE_PORT=5432
PRISMA_PORT=5555
NGINX_HTTPS_PORT=443

# app
WF_ADMIN_USER=your-admin-username
WF_ADMIN_EMAIL=admin@example.com

# frontend
VITE_API_URL=/api
VITE_DOMAIN_URL=https://your-domain
VITE_SOCKET_PATH=/socket.io
VITE_LIVEKIT_URL=wss://your-livekit-cloud-url
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
