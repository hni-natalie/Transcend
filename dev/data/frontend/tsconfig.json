{
  "compilerOptions": {
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowJs": true,
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "bundler",
    // "resolveJsonModule": true,  // incase need to import json files (mock data, static assets etc)
    "isolatedModules": true,    // ensure every file can be compiled alone
    "noEmit": true,             // only does typechecking, no outputting files
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@features/*": ["src/features/*"],
      "@features": ["src/features"],
      "@shared/*": ["src/shared/*"],
      "@shared": ["src/shared"],
      "@pages/*": ["src/pages/*"],
      "@pages": ["src/pages"],
      "@config/*": ["src/config/*"],
      "@config": ["src/config"],
      "@context/*": ["src/context/*"],
      "@context": ["src/context"]
    }
  },
  "include": ["src"]
}