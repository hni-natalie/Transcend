{
  "compilerOptions": {
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowJs": true,
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
	"ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"],
	  "@api/*": ["src/api/*"],
	  "@api": ["src/api"],
      "@features/*": ["src/features/*"],
      "@features": ["src/features"],
      "@shared/*": ["src/shared/*"],
      "@shared": ["src/shared"],
      "@pages/*": ["src/pages/*"],
      "@pages": ["src/pages"],
      "@config/*": ["src/config/*"],
      "@config": ["src/config"],
      "@context/*": ["src/context/*"],
      "@context": ["src/context"]
    }
  },
  "include": ["src"]
}