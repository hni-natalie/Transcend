generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ENUMS

enum UserStatus {
  offline
  online
  focus
  in_meeting
  away
}

enum AccessLevel {
  shared
  department
}

enum AttendanceStatus {
  pending
  absent
  present
}

enum TaskStatus {
  not_started
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum MeetingRole {
  organiser
  participant
}

enum DocumentType {
  faq
  meeting_summary
}

enum MeetingStatus {
  scheduled
  started
}

// MODELS

// ROLE
model Role {
  roleId    String   @id @default(uuid())
  roleName  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// DEPARTMENT 
model Department {
  dpId        String   @id @default(uuid())
  dpName      String   @unique
  dpLead      String?  @unique
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead  User?  @relation("DepartmentLead", fields: [dpLead], references: [userId], onDelete: SetNull)
  users User[] @relation("UserDepartment")

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  spaces    Space[]
}

// USER
model User {
  userId        String     @id @default(uuid())
  userEmail     String     @unique
  userPassword  String?
  userName      String
  userStatus    UserStatus @default(offline)

  roleId        String
  workspaceId   String?
  dpId          String?

  avatarUrl     String?
  city          String?
  country       String?
  timezone      String?

  authProvider  String? @default("email")
  googleId      String? @unique

  socketId      String?
  lastLoginAt   DateTime?
  emailVerified Boolean? @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role            Role        @relation(fields: [roleId], references: [roleId])
  workspace       Workspace?  @relation(fields: [workspaceId], references: [workspaceId])
  department      Department? @relation("UserDepartment", fields: [dpId], references: [dpId])
  leadDepartment  Department? @relation("DepartmentLead")

  // spacesKeyPerson Space? @relation("SpaceKeyPerson", fields: [spacesKeyPersonId], references: [spaceId])
  keyPersonSpaces Space[] @relation("SpaceKeyPerson")
  
  createdMeetings Meeting[] @relation("MeetingCreatedBy")

  tasks            Task[]
  assignedTasks    TaskAssignment[]

  meetingParticipations MeetingParticipant[]

  pinnedMeetings MeetingPin[]
}

// WORKSPACE 
model Workspace {
  workspaceId   String   @id @default(uuid())
  workspaceName String
  logoUrl       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  departments Department[]
  spaces      Space[]
  tasks       Task[]
  meetings    Meeting[]
  documents   Document[]
}

// SPACES
// for permission; add in be (canUserAccessSpace(user, space))
// @@unique([workspaceId, spaceName]) - spacename is now unique, diff workspace can hv same name
model Space {
  spaceId       String       @id @default(uuid())
  spaceName     String
  workspaceId   String
  accessLevel   AccessLevel  @default(shared)
  departmentId  String?
  keyPersonId   String?      @unique
  isPublicBook  Boolean?     @default(true)
  userCapacity  Int?         @default(0)
  // sortOrder    Int?         @default(0)    // drag / reorder spaces
  isOccupied    Boolean      @default(false) 
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [dpId])
  keyPerson  User?       @relation("SpaceKeyPerson", fields: [keyPersonId], references: [userId], onDelete: SetNull)

  meetings      Meeting[]

  @@unique([workspaceId, spaceName])
}

// TASKS
// @@ is fetch task by workspace/id
// add be contraint: if taskstatus == done, add completed date
model Task {
  taskId          String     @id @default(uuid())
  taskTitle       String
  taskDesc        String?
  taskStatus      TaskStatus @default(not_started)
  dueDate         DateTime?
  completedDate   DateTime?

  workspaceId     String
  createdByUserId String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  createdBy User      @relation(fields: [createdByUserId], references: [userId], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  assignedTo TaskAssignment[]

  @@index([workspaceId, taskStatus])
  @@index([workspaceId, createdByUserId])
  @@index([createdByUserId])
  @@index([deletedAt])
}

// TASK ASSIGNMENT
model TaskAssignment {
  assignedId   String @id @default(uuid())

  taskId       String
  userId       String

  taskPriority TaskPriority @default(medium)
  assignedDate DateTime @default(now())

  task Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [userId])

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@index([taskPriority])
}

// MEETING 
model Meeting {
  meetId          String   @id @default(uuid())
  workspaceId     String
  spaceId         String
  createdByUserId String

  meetTitle String
  meetDesc  String?
  meetStart DateTime
  meetEnd   DateTime
  status    MeetingStatus @default(scheduled)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  space     Space     @relation(fields: [spaceId], references: [spaceId])

  createdBy User @relation("MeetingCreatedBy", fields: [createdByUserId], references: [userId])

  participants MeetingParticipant[]

  pinnedBy MeetingPin[]

  @@index([workspaceId])
  @@index([spaceId])
  @@index([workspaceId, meetStart])
}

// MEETING PARTICIPANT
model MeetingParticipant {
  id        String @id @default(uuid())
  meetId    String
  userId    String

  role       MeetingRole
  attendance AttendanceStatus @default(pending)

  createdAt DateTime @default(now())

  meet Meeting @relation(fields: [meetId], references: [meetId])
  user User    @relation(fields: [userId], references: [userId])

  @@unique([meetId, userId])
  @@index([meetId, role])
  @@index([meetId])
  @@index([userId])
}

// MEETING PIN
model MeetingPin {
  pinId String @id @default(uuid())

  userId String
  meetId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetId], references: [meetId], onDelete: Cascade)

  @@unique([userId, meetId])
  @@index([userId])
  @@index([meetId])
}

// DOCUMENT
model Document {
  id          String   @id @default(uuid())
  title       String
  fileURL     String?
  content     String?
  type        DocumentType
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId])
  chunks    DocumentChunk[]

  @@index([workspaceId])
}

// DOCUMENT CHUNK
model DocumentChunk {
  id          String @id @default(uuid())
  content     String
  embedding   Unsupported("vector(1536)")?
  chunkIndex  Int
  documentId  String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@unique([documentId, chunkIndex])
}