generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ENUMS
enum UserStatus {
  offline
  online
  focus
  in_meeting
  away
}

enum AccessLevel {
  shared
  department
}

enum AttendanceStatus {
  pending
  absent
  present
}

enum TaskStatus {
  not_started
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum MeetingRole {
  organiser
  participant
}

enum MeetingStatus {
  scheduled
  started
}

enum DocumentType {
  faq
  meeting_summary
}

enum RecordingStatus {
  starting
  active
  completed
  failed
  stopped
}

enum SummaryStatus {
  pending
  processing
  completed
  failed
}

// TO ADD: Messages
enum ConversationType {
  direct
  group
}

enum AttachmentKind {
  pdf
  image
  document
  video
  audio
}

enum ActivityType {
  presence
  space
  task
  meeting
}

// MODELS
// ROLE
model Role {
  roleId    String   @id @default(uuid())
  roleName  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// DEPARTMENT 
model Department {
  dpId        String   @id @default(uuid())
  dpName      String   @unique
  dpLead      String?  @unique
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead  User?  @relation("DepartmentLead", fields: [dpLead], references: [userId], onDelete: SetNull)
  users User[] @relation("UserDepartment")

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  spaces    Space[]
}

// USER
model User {
  userId        String     @id @default(uuid())
  userEmail     String     @unique
  userPassword  String?
  userName      String
  userStatus    UserStatus @default(offline)

  roleId        String
  workspaceId   String?
  dpId          String?

  avatarUrl     String?
  city          String?
  country       String?
  timezone      String?

  authProvider  String? @default("email")
  googleId      String? @unique

  socketId      String?
  lastLoginAt   DateTime?
  emailVerified Boolean? @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role            Role        @relation(fields: [roleId], references: [roleId])
  workspace       Workspace?  @relation(fields: [workspaceId], references: [workspaceId])
  department      Department? @relation("UserDepartment", fields: [dpId], references: [dpId])
  leadDepartment  Department? @relation("DepartmentLead")

  // spacesKeyPerson Space? @relation("SpaceKeyPerson", fields: [spacesKeyPersonId], references: [spaceId])
  keyPersonSpaces Space[] @relation("SpaceKeyPerson")
  
  createdMeetings 			Meeting[] @relation("MeetingCreatedBy")
  meetingParticipations 	MeetingParticipant[]
  pinnedMeetings 			MeetingPin[]

  tasks            			Task[]
  assignedTasks    			TaskAssignment[]

  activityLogs 				Activity[]

// TO ADD: Messages
  createdConversations       Conversation[]            @relation("ConversationCreatedBy")
  conversationParticipations ConversationParticipant[]
  messages                   Message[]
  conversationPins           ConversationPin[]
}

// WORKSPACE 
model Workspace {
  workspaceId   String   @id @default(uuid())
  workspaceName String
  logoUrl       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users      	User[]
  departments	Department[]
  spaces     	Space[]
  tasks      	Task[]
  meetings   	Meeting[]
  documents   	Document[]
  activityLogs 	Activity[]
// TO ADD : Messages
  conversations Conversation[]
}

// SPACESm 
// for permission; add in be (canUserAccessSpace(user, space))
// @@unique([workspaceId, spaceName]) - spacename is now unique, diff workspace can hv same name
model Space {
  spaceId       String       @id @default(uuid())
  spaceName     String
  workspaceId   String
  accessLevel   AccessLevel  @default(shared)
  departmentId  String?
  keyPersonId   String?      @unique
  isPublicBook  Boolean?     @default(true)
  userCapacity  Int?         @default(0)
  // sortOrder    Int?         @default(0)    // drag / reorder spaces
  isOccupied    Boolean      @default(false) 
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [dpId])
  keyPerson  User?       @relation("SpaceKeyPerson", fields: [keyPersonId], references: [userId], onDelete: SetNull)

  meetings      Meeting[]

  @@unique([workspaceId, spaceName])
}

// TASKS
// @@ is fetch task by workspace/id
// add be contraint: if taskstatus == done, add completed date
model Task {
  taskId          String     @id @default(uuid())
  taskTitle       String
  taskDesc        String?
  taskStatus      TaskStatus @default(not_started)
  dueDate         DateTime?
  completedDate   DateTime?

  workspaceId     String
  createdByUserId String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  createdBy User      @relation(fields: [createdByUserId], references: [userId], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  assignedTo TaskAssignment[]

  @@index([workspaceId, taskStatus])
  @@index([workspaceId, createdByUserId])
  @@index([createdByUserId])
  @@index([deletedAt])
}

// TASK ASSIGNMENT
model TaskAssignment {
  assignedId   String @id @default(uuid())

  taskId       String
  userId       String

  taskPriority TaskPriority @default(medium)
  assignedDate DateTime @default(now())

  task Task @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [userId])

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@index([taskPriority])
}

// MEETING 
model Meeting {
  meetId          String   @id @default(uuid())
  workspaceId     String
  spaceId         String
  createdByUserId String

  meetTitle String
  meetDesc  String?
  meetStart DateTime
  meetEnd   DateTime
  status    MeetingStatus @default(scheduled)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  space     Space     @relation(fields: [spaceId], references: [spaceId])

  createdBy User @relation("MeetingCreatedBy", fields: [createdByUserId], references: [userId])

  participants          MeetingParticipant[]
  pinnedBy              MeetingPin[]
  recording             Recording[]
  meetingChatMessages   MeetingChatMessage[]

  @@index([workspaceId])
  @@index([spaceId])
  @@index([workspaceId, meetStart])
}

// MEETING PARTICIPANT
model MeetingParticipant {
  id        String @id @default(uuid())
  meetId    String
  userId    String

  role       MeetingRole
  attendance AttendanceStatus @default(pending)

  createdAt DateTime @default(now())

  meet Meeting @relation(fields: [meetId], references: [meetId])
  user User    @relation(fields: [userId], references: [userId])

  @@unique([meetId, userId])
  @@index([meetId, role])
  @@index([meetId])
  @@index([userId])
}

// MEETING PIN
model MeetingPin {
  pinId String @id @default(uuid())

  userId String
  meetId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetId], references: [meetId], onDelete: Cascade)

  @@unique([userId, meetId])
  @@index([userId])
  @@index([meetId])
}

// DOCUMENT
model Document {
  id          String   @id @default(uuid())
  title       String
  fileURL     String?
  content     String?
  type        DocumentType
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId])
  chunks    DocumentChunk[]

  @@index([workspaceId])
}

// DOCUMENT CHUNK
model DocumentChunk {
  id          String @id @default(uuid())
  content     String
  embedding   Unsupported("vector(1536)")?
  chunkIndex  Int
  documentId  String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@unique([documentId, chunkIndex])
}

// TO ADD: Messages
// CONVERSATION
// >>> directKey make sure that direct dms stay unique 
// eg; A+B = convo 1, B+A = convo1 (userIdA:userIdB)
// else; A+B = convo1, B+A = convo2
// for group; directKey can be null
model Conversation {
  conversationId  String           @id @default(uuid())
  workspaceId     String
  type            ConversationType
  groupName       String?          // only set when type = group
  avatarUrl       String?
  directKey       String?          @unique
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  workspace   	Workspace                 @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  createdBy		User                      @relation("ConversationCreatedBy", fields: [createdByUserId], references: [userId])
  participants	ConversationParticipant[]
  messages		Message[]
  pins			ConversationPin[]

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([deletedAt])
}

// CONVERSATION PARTICIPANT
// leftAt allows members to be removed without losing their chat history within the group
// their past messages still referenced via Message.authorId.
model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  removedAt      DateTime?
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

// MESSAGE
model Message {
  messageId      String    @id @default(uuid())
  conversationId String
  authorId       String
  text           String?
  callNote       String?	// KIV: can remove if not implemented
  linkUrl        String?	// FE's message.link 
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  conversation Conversation       @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [userId])
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

// MESSAGE ATTACHMENT
model MessageAttachment {
  id          String         @id @default(uuid())
  messageId   String
  name        String
  kind        AttachmentKind
  url         String	// how the app access the file (https://storage.example.com/messages/123/abc.pdf)
  path        String?	// where the file lives in storage (messages/123/abc.pdf)
  mimeType    String?
  sizeInBytes Int?		// DB stores raw bits (2000000), FE converts displays correct format (2MB)
  createdAt   DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@index([messageId])
}

// CONVERSATION PIN
// similar to meetingPin, pin is per user
// to replace localStorage in useConversations.ts
model ConversationPin {
  pinId          String   @id @default(uuid())
  userId         String
  conversationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Activity {
  activityId		String		@id @default(uuid())
  workspaceId		String
  userId			String
  type			ActivityType
  action			String
  contextTitle	String? 
  contextDetails	String?
  createdAt		DateTime	@default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@index([userId])
}

model Recording {
  recordingId String          @id @default(uuid())
  meetId      String          
  egressId    String
  filename    String
  status      RecordingStatus @default(starting)
  fileUrl     String?
  summaryStatus SummaryStatus @default(pending)
  summary  String? 
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  Meeting     Meeting         @relation(fields: [meetId], references: [meetId], onDelete: Cascade)

  @@index([egressId])
  @@index([meetId])
}

model MeetingChatMessage {
  id        String   @id @default(uuid())

  meetId    String
  senderId  String
  senderName String
  message   String

  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetId], references: [meetId], onDelete: Cascade)

  @@index([meetId])
}