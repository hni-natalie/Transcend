generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserStatus {
  offline
  online
  busy
  in_meeting
}

enum AccessLevel {
  shared
  department
}

enum AttendanceStatus {
  absent
  present
}

// ROLES
model Role {
  roleId    String   @id @default(uuid())
  roleName  String   @unique
  createdAt DateTime @default(now())

  users User[]
}

// DEPARTMENTS
model Department {
  dpId      String   @id @default(uuid())
  dpName    String   @unique
  dpLead    String?
  createdAt DateTime @default(now())

  lead  User?  @relation("DepartmentLead", fields: [dpLead], references: [userId])
  users User[] @relation("UserDepartment")

  // spaces Space[]
}

// USERS
model User {
  userId        String     @id @default(uuid())
  userEmail     String     @unique
  userPassword  String?
  userName      String
  userStatus    UserStatus @default(offline)
  roleId        String
  dpId          String
  avatarUrl     String?
  authProvider  String?    @default("email")
  googleId      String?    @unique
  emailVerified Boolean?   @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  role       Role       @relation(fields: [roleId], references: [roleId])
  department Department @relation("UserDepartment", fields: [dpId], references: [dpId])
  leadOf     Department[] @relation("DepartmentLead")

  // tasks Task[]

  // keySpaces Space[] @relation("SpaceKeyPerson")

  // organisedEvents     EventOrganiser[]
  // participatingEvents EventParticipant[]
}

